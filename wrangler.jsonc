{
  // Name muss exakt mit dem bereits im Cloudflare-Dashboard bestehenden
  // Worker "meine-website" uebereinstimmen (Workers & Pages -> meine-website),
  // sonst legt ein Deploy versehentlich einen ZWEITEN Worker an, statt den
  // bestehenden zu aktualisieren.
  "name": "meine-website",
  "compatibility_date": "2026-08-26",
  "main": "worker/index.js",
  // "www" lief bis eben noch ueber das inzwischen geloeschte Vercel-Projekt
  // (nur die nackte Domain war bereits als Custom Domain an diesen Worker
  // gebunden) - beide explizit hier eintragen, damit "www" ab jetzt
  // ebenfalls direkt vom Worker bedient wird.
  "routes": [
    { "pattern": "bayar-solutions.de", "custom_domain": true },
    { "pattern": "www.bayar-solutions.de", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // War "single-page-application" (jede unbekannte URL -> index.html mit
    // 200), solange /impressum & Co. nur client-seitig per react-router-dom
    // existierten und keinen eigenen statischen Build-Output hatten. Das ist
    // seit vite-plugins/seoHead.js nicht mehr der Fall - jede echte Route
    // hat jetzt ihre eigene vorgerenderte <route>.html, die der Asset-
    // Handler bei einem direkten Aufruf/Reload ohnehin per exaktem
    // Datei-Match ausliefert (mit oder ohne diese Einstellung). Fuer
    // tatsaechlich unbekannte Pfade liefert "404-page" jetzt die von
    // seoHead.js miterzeugte dist/404.html mit echtem HTTP 404 aus, statt
    // sie als zweite, falsch-kanonische Kopie der Startseite mit 200
    // auszuliefern.
    "not_found_handling": "404-page",
    // Nur fuer /office (und Unterpfade) wird der Worker ueberhaupt
    // aufgerufen - jede andere URL wird weiterhin ausschliesslich vom
    // Asset-Handler bedient, unveraendert zum bisherigen Verhalten.
    "run_worker_first": ["/office", "/office/*"]
  }
}
